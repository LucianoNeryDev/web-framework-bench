{
  "name": "wfb-angular",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node tools/prepare.mjs",
    "build:static": "node tools/prepare.mjs && ng build --configuration static && node tools/post-static.mjs",
    "build:server": "node tools/prepare.mjs && ng build --configuration server",
    "start": "node dist/angular/server/server.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/platform-server": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/ssr": "22.2.7",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "typescript": "6.0.3"
  }
}
