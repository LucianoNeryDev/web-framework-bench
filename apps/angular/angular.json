{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "angular": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["../../shared/public/style.css"],
            "deployUrl": "/",
            "outputMode": "server",
            "security": { "allowedHosts": ["*"] },
            "ssr": { "entry": "src/server.ts" }
          },
          "configurations": {
            "server": {
              "outputHashing": "all"
            },
            "static": {
              "outputHashing": "all",
              "outputMode": "static",
              "ssr": false,
              "fileReplacements": [
                { "replace": "src/app/app.routes.server.ts", "with": "src/app/app.routes.server.static.ts" }
              ]
            }
          },
          "defaultConfiguration": "server"
        }
      }
    }
  }
}
