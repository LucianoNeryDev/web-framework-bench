{
  "name": "wfb-qwik",
  "description": "Field Notes on Qwik City",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "scripts": {
    "build:static": "vite build && vite build -c adapters/static/vite.config.ts",
    "build:server": "vite build && vite build -c adapters/express/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "serve": "node server/entry.express",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.4",
    "@builder.io/qwik-city": "1.20.4",
    "@types/express": "4.17.25",
    "@types/node": "20.19.0",
    "typescript": "5.4.5",
    "vite": "7.3.7",
    "vite-tsconfig-paths": "4.3.2"
  },
  "dependencies": {
    "express": "4.22.0",
    "undici": "8.12.4"
  }
}
