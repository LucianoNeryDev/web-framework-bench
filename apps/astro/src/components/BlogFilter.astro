---
import { tags } from "../lib/content";

interface Props {
  q: string;
  tag: string;
  total: number;
  shown: number;
}
const { q, tag, total, shown } = Astro.props;
---
<form class="filters" role="search" action="/blog" method="get" data-filters>
<label for="q">Search posts</label>
<input id="q" name="q" type="search" placeholder="Search titles and summaries" autocomplete="off" value={q || undefined}>
<div class="tag-filter" role="group" aria-label="Filter by tag">
<button type="button" class="chip" data-tag="" aria-pressed={String(!tag)}>All</button>
{tags.map((t) => <button type="button" class="chip" data-tag={t.slug} aria-pressed={String(tag === t.slug)}>{t.name}</button>)}
</div>
</form>
<h2 class="visually-hidden">Posts</h2>
<p class="result-count" aria-live="polite" data-result-count>Showing {shown} of {total} posts</p>
<div class="card-grid" data-post-list>
<slot />
</div>
<p class="empty" data-empty hidden={shown !== 0 ? true : undefined}>No posts match.</p>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]");
  const list = document.querySelector("[data-post-list]");
  if (form && list) {
    const input = form.querySelector<HTMLInputElement>('input[name="q"]')!;
    const chips = [...form.querySelectorAll<HTMLElement>("[data-tag]")];
    const cards = [...list.querySelectorAll<HTMLElement>("[data-post]")];
    const count = document.querySelector("[data-result-count]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const params = new URLSearchParams(location.search);
    let query = params.get("q") ?? "";
    let tag = params.get("tag") ?? "";
    input.value = query;

    const apply = () => {
      const needle = query.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const ok = (!tag || card.dataset.tags!.split(" ").includes(tag)) && (!needle || card.dataset.search!.includes(needle));
        card.hidden = !ok;
        if (ok) shown++;
      }
      for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.tag === tag));
      count.textContent = `Showing ${shown} of ${cards.length} posts`;
      empty.hidden = shown !== 0;
      const url = new URL(location.href);
      if (needle) url.searchParams.set("q", query.trim()); else url.searchParams.delete("q");
      if (tag) url.searchParams.set("tag", tag); else url.searchParams.delete("tag");
      history.replaceState(null, "", url);
    };

    input.addEventListener("input", () => { query = input.value; apply(); });
    form.addEventListener("submit", (event) => { event.preventDefault(); query = input.value; apply(); });
    for (const chip of chips) chip.addEventListener("click", () => { tag = chip.dataset.tag ?? ""; apply(); });
    apply();
  }
</script>
