<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
<channel>
<title>{{@site.title}}</title>
<link>{{@site.url}}/</link>
<description>{{@site.description}}</description>
<language>en</language>
{{#get "posts" limit="all"}}
{{#foreach posts}}
<item>
<title>{{title}}</title>
<link>{{@site.url}}/blog/{{slug}}</link>
<guid>{{@site.url}}/blog/{{slug}}</guid>
<pubDate>{{date published_at format="ddd, DD MMM YYYY HH:mm:ss [GMT]" locale="en"}}</pubDate>
<description>{{custom_excerpt}}</description>
</item>
{{/foreach}}
{{/get}}
</channel>
</rss>
