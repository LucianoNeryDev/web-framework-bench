<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{{#get "posts" limit="all"}}
<url><loc>{{@site.url}}/</loc>{{#foreach posts limit="1"}}<lastmod>{{date published_at format="YYYY-MM-DD"}}</lastmod>{{/foreach}}</url>
<url><loc>{{@site.url}}/blog</loc>{{#foreach posts limit="1"}}<lastmod>{{date published_at format="YYYY-MM-DD"}}</lastmod>{{/foreach}}</url>
{{#get "pages" limit="all"}}
{{#foreach pages}}
<url><loc>{{@site.url}}/{{slug}}</loc></url>
{{/foreach}}
{{/get}}
{{#foreach posts}}
<url><loc>{{@site.url}}/blog/{{slug}}</loc><lastmod>{{date published_at format="YYYY-MM-DD"}}</lastmod></url>
{{/foreach}}
{{/get}}
</urlset>
